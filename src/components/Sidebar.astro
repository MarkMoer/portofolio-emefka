---

<aside
  id="sidebar"
  class="fixed top-0 left-0 z-40 h-full w-64 -translate-x-full bg-surface border-r border-line p-6 flex flex-col transition-transform duration-300 lg:translate-x-0"
>
  <!-- Profile -->
  <div class="flex items-center gap-3 mb-8">
    <img
      src="/img/faris.png"
      alt="Muhammad Faris Kamaaluddin"
      class="w-12 h-12 rounded-full object-cover border-2 border-secondary"
    />
    <div>
      <p class="font-display font-bold text-primary leading-tight">
        Faris Kamaaluddin
      </p>
      <p class="text-xs text-secondary">Web Developer</p>
    </div>
  </div>

  <!-- Nav -->
  <nav class="flex-1">
    <ul class="space-y-1">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              data-i18n={item.key}
              class="block px-4 py-2 rounded-md text-muted hover:text-primary hover:bg-surface-2 transition-colors"
            >
              {item.key}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <!-- Socials -->
  <div class="pt-6 border-t border-line">
    <div class="flex gap-3 justify-center mb-4">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={s.label}
            class="w-9 h-9 rounded-full flex items-center justify-center border border-line text-muted hover:text-secondary hover:border-secondary transition-colors"
          >
            <svg
              role="img"
              viewBox="0 0 24 24"
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              class="fill-current"
            >
              <title>{s.label}</title>
              <path d={s.d} />
            </svg>
          </a>
        ))
      }
    </div>
    <div class="flex justify-center">
      <ThemeLangToggle />
    </div>
  </div>
</aside>

<!-- Mobile backdrop -->
<div id="sidebar-backdrop" class="hidden fixed inset-0 z-30 bg-black/60 lg:hidden"></div>

<script>
  const sidebar = document.getElementById('sidebar')
  const backdrop = document.getElementById('sidebar-backdrop')

  function openSidebar() {
    sidebar.classList.remove('-translate-x-full')
    backdrop.classList.remove('hidden')
  }

  function closeSidebar() {
    sidebar.classList.add('-translate-x-full')
    backdrop.classList.add('hidden')
  }

  backdrop.addEventListener('click', closeSidebar)

  sidebar.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      if (window.innerWidth < 1024) closeSidebar()
    })
  })

  // Expose for the mobile hamburger button in the topbar
  window.__openSidebar = openSidebar
  window.__closeSidebar = closeSidebar
</script>