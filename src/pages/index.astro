---
import Base from '../layouts/Base.astro'
import Sidebar from '../components/Sidebar.astro'
import Aurora from '../components/ui/Aurora.tsx'
import HeroRoles from '../components/HeroRoles.tsx'
import CountUp from '../components/ui/CountUp.tsx'
import ProjectCard from '../components/ProjectCard.tsx'
import type { Project } from '../components/ProjectCard.tsx'
import ContactForm from '../components/ContactForm.tsx'

const projects: Project[] = [
  {
    key: 'apindo',
    image: '/img/project/Project1.PNG',
    repo: 'https://github.com/MarkMoer/prev-web-apindo',
    tech: ['React.js', 'Express.js', 'MySQL'],
  },
  {
    key: 'flutter',
    image: '/img/project/Project2.png',
    repo: 'https://gitlab.com/faris.kamaaluddin/bootcampflutter',
    tech: ['Flutter', 'Firebase'],
  },
  {
    key: 'quotes',
    image: '/img/project/Project3.PNG',
    repo: 'https://github.com/MarkMoer/',
    tech: ['React.js', 'Tailwind CSS'],
  },
  {
    key: 'sholat',
    image: '/img/project/Project4.PNG',
    repo: 'https://github.com/MarkMoer/ayo-sholat',
    live: 'https://ayo-sholat.emefka-app.my.id/',
    tech: ['React.js', 'Vite', 'Tailwind CSS'],
  },
  {
    key: 'anime',
    image: '/img/project/Project5.PNG',
    repo: 'https://github.com/MarkMoer/animelist/',
    tech: ['Next.js', 'Tailwind CSS'],
  },
  {
    key: 'pos',
    image: '/img/project/Project6.PNG',
    repo: 'https://github.com/MarkMoer/-laravel-pos-backend-Muhammad-Faris-Kamaaluddin',
    tech: ['Laravel', 'MySQL'],
  },
]

const skills = [
  {
    cat: 'skills.frontend',
    label: 'Frontend',
    items: ['React.js', 'Next.js', 'Tailwind CSS', 'JavaScript', 'HTML/CSS', 'Vite'],
  },
  {
    cat: 'skills.backend',
    label: 'Backend',
    items: ['Laravel', 'Express.js', 'MySQL'],
  },
  {
    cat: 'skills.mobile',
    label: 'Mobile',
    items: ['Flutter', 'Dart'],
  },
  {
    cat: 'skills.tools',
    label: 'Tools',
    items: ['Git', 'GitHub', 'Firebase', 'REST API', 'Vercel'],
  },
]

const experiences = [
  {
    key: 'transcon',
    period: 'Januari 2024 - Sekarang',
    title: 'IT Programmer',
    org: 'PT Transcon Indonesia',
    desc: 'Bertanggung jawab atas maintenance dan pengembangan project internal perusahaan, termasuk sistem mini ERP. Turut menangani kebutuhan IT Support untuk memastikan kelancaran operasional harian karyawan.',
    tags: ['ERP', 'Maintenance', 'IT Support'],
  },
  {
    key: 'sanber',
    period: 'Bootcamp',
    title: 'Mobile Developer - Bootcamp Flutter',
    org: 'Sanbercode',
    desc: 'Membangun aplikasi mobile Flutter, mengintegrasikan Firebase untuk autentikasi, dan mengonsumsi REST API.',
    tags: ['Flutter', 'Firebase'],
  },
  {
    key: 'apindo',
    period: 'Proyek',
    title: 'Fullstack Web Developer',
    org: 'APINDO DPK Gresik',
    desc: 'Membangun website profil dengan React.js, Express.js, dan MySQL, termasuk formulir pendaftaran anggota.',
    tags: ['React.js', 'Express.js', 'MySQL'],
  },
  {
    key: 'self',
    period: 'Sedang Berjalan',
    title: 'Self-Taught Developer',
    org: 'Belajar Mandiri',
    desc: 'Terus belajar teknologi baru seperti Next.js, Laravel, dan Tailwind CSS lewat proyek nyata.',
    tags: ['Next.js', 'Laravel', 'Tailwind CSS'],
  },
]
---

<Base>
  <!-- Mobile topbar -->
  <header class="fixed top-0 left-0 right-0 z-40 lg:hidden bg-surface/90 backdrop-blur border-b border-line">
    <div class="flex items-center justify-between px-4 h-16">
      <a href="#home" class="font-display font-bold text-xl text-primary">emefka</a>
      <button
        id="mobile-menu-btn"
        type="button"
        aria-label="Open menu"
        class="w-10 h-10 rounded-lg flex items-center justify-center border border-line text-primary hover:border-secondary transition-colors"
      >
        <svg viewBox="0 0 24 24" width="20" class="fill-current" aria-hidden="true">
          <path d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z" />
        </svg>
      </button>
    </div>
  </header>

  <Sidebar />

  <main class="lg:pl-64 pt-16 lg:pt-0">
    <!-- Hero -->
    <section id="home" class="relative min-h-[92vh] flex items-center overflow-hidden">
      <Aurora client:load />
      <div class="container relative z-10">
        <div class="max-w-3xl">
          <p
            class="inline-flex items-center gap-2 mb-6 px-4 py-1.5 rounded-full border border-line bg-surface/70 text-xs font-semibold text-secondary"
            data-i18n="hero.status"
          >
            Terbuka untuk peluang kerja
          </p>
          <p class="text-lg md:text-xl text-muted mb-3" data-i18n="hero.greeting">
            Hai, saya
          </p>
          <h1
            class="font-display font-bold text-4xl md:text-6xl text-primary leading-tight mb-3"
            data-i18n="hero.name"
          >
            Muhammad Faris Kamaaluddin
          </h1>
          <p class="font-display font-semibold text-2xl md:text-3xl mb-6">
            <HeroRoles client:load />
          </p>
          <p class="text-muted text-base md:text-lg mb-8 max-w-xl leading-relaxed" data-i18n="hero.tagline">
            Membangun pengalaman web modern dengan kode yang bersih.
          </p>
          <div class="flex flex-wrap gap-4">
            <a
              href="#contact"
              class="inline-flex items-center gap-2 py-3 px-7 rounded-full bg-secondary text-[#1a1a1d] font-semibold hover:opacity-90 transition-opacity"
              data-i18n="hero.cta.contact"
            >
              Hubungi Saya
            </a>
            <a
              href="#projects"
              class="inline-flex items-center gap-2 py-3 px-7 rounded-full border-2 border-line text-primary hover:border-secondary hover:text-secondary transition-colors"
              data-i18n="hero.cta.projects"
            >
              Lihat Proyek
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="py-24">
      <div class="container">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold text-secondary uppercase tracking-widest mb-2">
            01
          </p>
          <h2
            class="font-display font-bold text-3xl md:text-4xl text-primary mb-6"
            data-i18n="about.title"
          >
            Tentang Saya
          </h2>
          <p class="text-muted text-base md:text-lg leading-relaxed mb-10" data-i18n="about.body">
            Saya adalah pengembang web yang berdomisili di Gresik, Jawa Timur, dengan fokus
            pada pengembangan fullstack. Memiliki pengalaman kerja sebagai IT Programmer dan
            keahlian membangun aplikasi web modern menggunakan React.js, Next.js, Laravel,
            serta Flutter untuk pengembangan mobile. Saya senang mempelajari teknologi baru
            dan menerapkannya untuk menciptakan solusi digital yang berdampak.
          </p>

          <div class="grid grid-cols-3 gap-4">
            <div class="p-5 rounded-2xl border border-line bg-surface text-center">
              <p class="font-display font-bold text-3xl md:text-4xl text-secondary">
                <CountUp client:load end={3} suffix="+" />
              </p>
              <p class="text-sm text-muted mt-2" data-i18n="about.stat.years">Tahun Pengalaman Kerja</p>
            </div>
            <div class="p-5 rounded-2xl border border-line bg-surface text-center">
              <p class="font-display font-bold text-3xl md:text-4xl text-secondary">
                <CountUp client:load end={6} suffix="+" />
              </p>
              <p class="text-sm text-muted mt-2" data-i18n="about.stat.projects">Proyek</p>
            </div>
            <div class="p-5 rounded-2xl border border-line bg-surface text-center">
              <p class="font-display font-bold text-3xl md:text-4xl text-secondary">
                <CountUp client:load end={5} suffix="+" />
              </p>
              <p class="text-sm text-muted mt-2" data-i18n="about.stat.stacks">Teknologi</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills -->
    <section id="skills" class="py-24 bg-surface/40">
      <div class="container">
        <p class="text-sm font-semibold text-secondary uppercase tracking-widest mb-2">02</p>
        <h2
          class="font-display font-bold text-3xl md:text-4xl text-primary mb-4"
          data-i18n="skills.title"
        >
          Keahlian
        </h2>
        <p class="text-muted mb-12 max-w-2xl" data-i18n="skills.subtitle">
          Teknologi yang saya gunakan untuk membangun produk digital.
        </p>

        <div class="grid md:grid-cols-2 gap-6">
          {
            skills.map((group) => (
              <div class="p-6 rounded-2xl border border-line bg-surface">
                <h3
                  class="font-display font-bold text-lg text-primary mb-4 flex items-center gap-2"
                  data-i18n={group.cat}
                >
                  {group.label}
                </h3>
                <div class="flex flex-wrap gap-2">
                  {group.items.map((item) => (
                    <span
                      class="px-3 py-1.5 rounded-lg bg-surface-2 border border-line text-sm text-primary"
                    >
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="py-24">
      <div class="container">
        <p class="text-sm font-semibold text-secondary uppercase tracking-widest mb-2">03</p>
        <h2
          class="font-display font-bold text-3xl md:text-4xl text-primary mb-4"
          data-i18n="experience.title"
        >
          Pengalaman
        </h2>
        <p class="text-muted mb-12" data-i18n="experience.subtitle">
          Perjalanan belajar dan membangun.
        </p>

        <div class="relative space-y-8 before:absolute before:left-[7px] before:top-2 before:bottom-2 before:w-px before:bg-line">
          {
            experiences.map((exp) => (
              <div class="relative pl-10">
                <span class="absolute left-0 top-1.5 w-[15px] h-[15px] rounded-full border-2 border-secondary bg-surface"></span>
                <div class="p-6 rounded-2xl border border-line bg-surface">
                  <p
                    class="text-xs font-semibold text-secondary mb-1"
                    data-i18n={`experience.${exp.key}.period`}
                  >
                    {exp.period}
                  </p>
                  <h3
                    class="font-display font-bold text-lg text-primary mb-0.5"
                    data-i18n={`experience.${exp.key}.title`}
                  >
                    {exp.title}
                  </h3>
                  <p
                    class="text-sm text-muted mb-3"
                    data-i18n={`experience.${exp.key}.org`}
                  >
                    {exp.org}
                  </p>
                  <p
                    class="text-muted text-sm leading-relaxed mb-4"
                    data-i18n={`experience.${exp.key}.desc`}
                  >
                    {exp.desc}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {exp.tags.map((tag) => (
                      <span class="text-xs px-2.5 py-1 rounded-md bg-surface-2 border border-line text-muted">
                        {tag}
                      </span>
                    ))}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="py-24 bg-surface/40">
      <div class="container">
        <p class="text-sm font-semibold text-secondary uppercase tracking-widest mb-2">04</p>
        <h2
          class="font-display font-bold text-3xl md:text-4xl text-primary mb-4"
          data-i18n="projects.title"
        >
          Proyek
        </h2>
        <p class="text-muted mb-12" data-i18n="projects.subtitle">
          Beberapa karya yang telah saya bangun.
        </p>

        <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">
          {projects.map((p) => <ProjectCard client:load project={p} />)}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-24">
      <div class="container">
        <div class="max-w-2xl mx-auto">
          <p class="text-sm font-semibold text-secondary uppercase tracking-widest mb-2 text-center">
            05
          </p>
          <h2
            class="font-display font-bold text-3xl md:text-4xl text-primary mb-4 text-center"
            data-i18n="contact.title"
          >
            Kontak
          </h2>
          <p class="text-muted mb-12 text-center" data-i18n="contact.subtitle">
            Punya pertanyaan atau ingin bekerja sama? Kirim pesan, saya akan segera
            merespons.
          </p>

          <div class="p-6 md:p-8 rounded-2xl border border-line bg-surface">
            <ContactForm client:load />
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="border-t border-line py-10">
      <div class="container flex flex-col md:flex-row items-center justify-between gap-4 text-center md:text-left">
        <div>
          <p class="font-display font-bold text-primary mb-1">emefka</p>
          <p class="text-sm text-muted" data-i18n="footer.tagline">
            Membangun web dengan hati dan ngoding setiap hari.
          </p>
        </div>
        <p class="text-xs text-muted">
          © <span id="year"></span> Muhammad Faris Kamaaluddin.{" "}
          <span data-i18n="footer.rights">Semua Hak Dilindungi.</span>
        </p>
      </div>
    </footer>
  </main>

  <script>
    // Year
    document.getElementById('year').textContent = new Date().getFullYear()

    // Mobile menu
    document.getElementById('mobile-menu-btn').addEventListener('click', () => {
      window.__openSidebar()
    })

    // Smooth close on nav click handled in Sidebar
  </script>
</Base>